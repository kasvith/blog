---
import { Font } from "astro:assets";
import "../styles/global.css";
import { Rss } from "@lucide/astro";
import Brand from "../components/Brand.astro";
import { SITE } from "../data/site";
import { social } from "../data/brands";

interface Props {
  title?: string;
  description?: string;
  /** Share image: a generated 1200×630 /og/ card's path, or an imported image such as a post's cover. */
  image?: string | { src: string; width: number; height: number };
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  jsonLd?: object;
  active?: "posts" | "projects" | "about";
  /** Keep the page out of search results while still letting crawlers follow its links. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = "/og/default.png",
  type = "website",
  published,
  modified,
  jsonLd,
  active,
  noindex,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} (kasvith)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = typeof image === "string" ? { src: image, width: 1200, height: 630 } : image;
const imageUrl = new URL(share.src, Astro.site);
const nav = [
  { href: "/posts/", label: "Posts", key: "posts" },
  { href: "/projects/", label: "Open source", key: "projects" },
  { href: "/about/", label: "About", key: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Body and heading fonts are on every page, so fetch them alongside the HTML. Mono loads only where code is. -->
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      // Arriving through a page transition: skip the hero's entrance animation, or the page appears twice.
      addEventListener("pagereveal", (e) => e.viewTransition && document.documentElement.classList.add("vt"));
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="kasvith.me" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={title ?? fullTitle} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kasvith" />
    <meta name="twitter:creator" content="@kasvith" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f1f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08131a" media="(prefers-color-scheme: dark)" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...jsonLd })} />}
    <!-- Prerender same-site pages on hover, so navigations (and their transitions) feel instant. Files like feed.xml are skipped. -->
    <script is:inline type="speculationrules">
      { "prerender": [{ "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/*.*" } }] }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="head">
        <a class="head-brand" href="/">
          {SITE.name}
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? "page" : undefined}>
              {n.label}
            </a>
          ))}
          <a href="/feed.xml">
            <Rss />
            RSS
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <p>
          Say hi at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. I'm kasvith on <a href={SITE.github}>GitHub</a> and{" "}
          <a href={SITE.twitter}>Twitter</a>.
        </p>
        <span class="foot-icons">
          <a href={SITE.github} aria-label="GitHub">
            <Brand path={social.github} />
          </a>
          <a href={SITE.twitter} aria-label="Twitter">
            <Brand path={social.x} />
          </a>
          <a href={SITE.linkedin} aria-label="LinkedIn">
            <Brand path={social.linkedin} />
          </a>
          <a href="/feed.xml" aria-label="RSS">
            <Rss />
          </a>
          <span>
            © {new Date().getFullYear()} {SITE.name}
          </span>
        </span>
      </footer>
    </div>
    <script>
      // Copy buttons for code blocks. Added by script so a page read without JavaScript has no dead button.
      const icon = (d: string) =>
        `<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
      const idle =
        icon(
          '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
        ) + "copy";
      const done = icon('<path d="M20 6 9 17l-5-5"/>') + "copied";

      for (const bar of document.querySelectorAll(".code-bar")) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy";
        button.innerHTML = idle;
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(bar.parentElement!.querySelector("code")!.textContent ?? "");
          button.innerHTML = done;
          setTimeout(() => (button.innerHTML = idle), 1500);
        });
        bar.append(button);
      }

      // Post images open full size in a native <dialog>, which brings Esc, focus trapping and focus return.
      const viewer = document.createElement("dialog");
      viewer.className = "lightbox";
      viewer.innerHTML = `<button type="button" class="lightbox-close" aria-label="Close">${icon('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>')}</button><img alt="" /><p></p>`;
      document.body.append(viewer);
      const big = viewer.querySelector("img")!;
      const caption = viewer.querySelector("p")!;
      viewer.addEventListener("click", () => viewer.close());

      for (const img of document.querySelectorAll<HTMLImageElement>(".prose img")) {
        if (img.closest("a")) continue;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "zoom";
        button.ariaLabel = img.alt ? `Enlarge image: ${img.alt}` : "Enlarge image";
        img.replaceWith(button);
        button.append(img);
        button.addEventListener("click", () => {
          big.src = img.currentSrc;
          big.alt = img.alt;
          caption.textContent = img.alt;
          viewer.style.setProperty("--w", String(img.naturalWidth));
          viewer.style.setProperty("--r", String(img.naturalWidth / img.naturalHeight));
          viewer.showModal();
        });
      }
    </script>
  </body>
</html>
