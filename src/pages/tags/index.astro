---
import Base from "../../layouts/Base.astro";
import { getPosts } from "../../lib/posts";

const counts = new Map<string, number>();
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="Tags" description="Every topic Kasun Vithanage has written about." active="posts">
  <section class="listing">
    <header class="page-head">
      <h1>Tags</h1>
    </header>
    <ul class="tags">
      {tags.map(([t, n]) => (
        <li>
          <a class="chip" href={`/tags/${t}/`}>
            #{t} <span class="tl-org">{n}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
