---
import Base from "../../layouts/Base.astro";
import PostRows from "../../components/PostRows.astro";
import { getPosts, type Post } from "../../lib/posts";

// Same /tags/<tag>/ URLs Gridsome generated.
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<Base title={`#${tag}`} description={`Posts by Kasun Vithanage tagged ${tag}.`} active="posts" noindex>
  <section class="listing">
    <header class="page-head">
      <a class="back" href="/tags/">
        ← All tags
      </a>
      <h1>#{tag}</h1>
      <p class="standfirst">
        {posts.length} {posts.length === 1 ? "post" : "posts"}
      </p>
    </header>
    <PostRows posts={posts} />
  </section>
</Base>
